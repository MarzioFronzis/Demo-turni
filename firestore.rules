rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Versione semplificata: un solo titolare autenticato, accesso completo.
    // Se in futuro aggiungerai altri utenti, restringi qui per uid specifici.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
